FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Webhola"
            VALUE "FileDescription", "Webhola - Website development tools"
            VALUE "FileVersion", "0.2.0"
            VALUE "InternalName", "Webhola"
            VALUE "OriginalFilename", "Webhola.exe"
            VALUE "ProductName", "Webhola"
            VALUE "ProductVersion", "0.2.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
